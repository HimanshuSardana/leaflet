{
  "openapi": "3.1.0",
  "info": {
    "title": "leaflet",
    "description": "Self-hostable ebook, manga and light novel server",
    "license": {
      "name": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "version",
        "responses": {
          "200": {
            "description": "server identity and contract version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness + readiness: 200 only while the database answers.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "server and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Stable, machine-readable slug: `not_found`, `unauthorized`, …"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "name",
          "version",
          "api",
          "schema"
        ],
        "properties": {
          "api": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "string",
            "description": "Schema revision this server migrated to; clients refuse to sync above it."
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  }
}
