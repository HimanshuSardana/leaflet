{
  "openapi": "3.1.0",
  "info": {
    "title": "leaflet",
    "description": "Self-hostable ebook, manga and light novel server",
    "license": {
      "name": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "description": "wrong email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "session revoked, cookie cleared"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchanges the refresh cookie for a new access token, rotating the session.\nBrowsers send `Origin` on POST; if it is present it must match the host the\nrequest arrived on, which (with SameSite=Strict) closes the CSRF hole.",
        "operationId": "refresh",
        "responses": {
          "200": {
            "description": "new access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "no valid session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "account created and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "invalid email, name or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "registration closed or invite code wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/books": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Lists the caller's shelf, alphabetically by sort title.",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "the caller's books",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "401": {
            "description": "missing or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "books"
        ],
        "summary": "Uploads one PDF or EPUB as `multipart/form-data` with a field named `file`.",
        "description": "The format is sniffed from the bytes, so a mislabelled file is rejected\ninstead of being stored as something it is not. Uploading the same bytes\ntwice is a no-op that answers 200 with the existing book; new books answer\n201.",
        "operationId": "upload",
        "requestBody": {
          "description": "one part, name `file`, containing the PDF or EPUB",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "this copy was already in the library",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "201": {
            "description": "book stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "malformed or empty upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "missing or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "upload is larger than the configured limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "the bytes are not a PDF or EPUB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/books/{id}": {
      "get": {
        "tags": [
          "books"
        ],
        "operationId": "get_one",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "book id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "no such book, or not this user's",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/books/{id}/file": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Serves the stored file. Byte ranges are honoured because PDF readers seek\ninto the file instead of downloading it whole.",
        "operationId": "download",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "book id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the whole file"
          },
          "206": {
            "description": "the requested byte range"
          },
          "404": {
            "description": "no such book, or not this user's",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "416": {
            "description": "range not satisfiable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The account behind the bearer token, loaded fresh so a role change or a\ndeleted account takes effect immediately.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "the signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "missing or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "version",
        "responses": {
          "200": {
            "description": "server identity and contract version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness + readiness: 200 only while the database answers.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "server and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessToken": {
        "type": "object",
        "required": [
          "access_token",
          "access_expires_at"
        ],
        "properties": {
          "access_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "access_token": {
            "type": "string"
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "user",
          "access_token",
          "access_expires_at"
        ],
        "properties": {
          "access_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "access_token": {
            "type": "string",
            "description": "Short-lived; the client keeps this in memory and refreshes via cookie."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Book": {
        "type": "object",
        "description": "A book as the API exposes it: metadata plus the blob's address, never the\nblob itself.",
        "required": [
          "id",
          "title",
          "format",
          "byte_size",
          "sha256",
          "added_at"
        ],
        "properties": {
          "added_at": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "byte_size": {
            "type": "integer",
            "format": "int64"
          },
          "format": {
            "$ref": "#/components/schemas/BookFormat"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "series": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": "string",
            "description": "sha256 of the stored bytes; stable across re-uploads."
          },
          "title": {
            "type": "string"
          },
          "volume": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "BookFormat": {
        "type": "string",
        "description": "Container formats leaflet reads as-is. Sniffed from the bytes, never from\nthe filename: a `.pdf` that is really an epub must not fool the server.",
        "enum": [
          "pdf",
          "epub",
          "cbz"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Stable, machine-readable slug: `not_found`, `unauthorized`, …"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "invite_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required once an account exists; ignored for the bootstrap account."
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegistrationMode": {
        "type": "string",
        "description": "What a client may do about accounts on this server.",
        "enum": [
          "open",
          "invite",
          "closed"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "member"
        ]
      },
      "User": {
        "type": "object",
        "description": "A user as the API may expose it: never carries the password hash.",
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "name",
          "version",
          "api",
          "schema",
          "registration"
        ],
        "properties": {
          "api": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "registration": {
            "$ref": "#/components/schemas/RegistrationMode",
            "description": "Whether a client may register, and whether it needs an invite code."
          },
          "schema": {
            "type": "string",
            "description": "Schema revision this server migrated to; clients refuse to sync above it."
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  }
}
